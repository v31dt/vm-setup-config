! ~/.Xresources — urxvt (rxvt-unicode), adapted from the old foot.ini.
! Loaded by ~/.xinitrc (startx) AND by the i3 autostart (xrdb -merge), so it
! applies whether you use startx or a display manager login.

! --- scaling ---------------------------------------------------------------
! X11 has no true fractional scaling (that GNOME/Wayland 1.6x you had). The
! closest is DPI-based font scaling: 96 = 1.0x, 144 = 1.5x, 150 ~= 1.56x,
! 160 ~= 1.67x, 192 = 2.0x. This scales Xft fonts + GTK/Qt/Firefox/rofi, NOT
! raw pixels, so it won't look identical to GNOME scaling. Tune to taste.
Xft.dpi: 150
Xcursor.size: 36

! --- foot.ini [main]/[cursor]/[mouse] equivalents ---
! "JetBrains Mono" matches the fonts-jetbrains-mono (Kali/Debian) and
! ttf-jetbrains-mono (Arch) packages. Nerd Font glyphs aren't needed here.
URxvt.font:            xft:JetBrains Mono:size=12
URxvt.letterSpace:     0
URxvt.internalBorder:  11
URxvt.saveLines:       50000
URxvt.scrollBar:       false
URxvt.cursorBlink:     false
URxvt.cursorUnderline: false
URxvt.pointerBlank:    true
URxvt.urgentOnBell:    true

! --- clipboard (foot used Ctrl+c/Ctrl+v; Shift variants keep Ctrl+C = SIGINT) ---
URxvt.perl-ext-common: default,selection-to-clipboard,matcher
URxvt.keysym.Control-Shift-C: eval:selection_to_clipboard
URxvt.keysym.Control-Shift-V: eval:paste_clipboard
URxvt.url-launcher:    xdg-open
URxvt.matcher.button:  1

! --- Kali-ish dark-blue palette (replaces the old foot light-parchment theme) ---
URxvt.background:  #0b1220
URxvt.foreground:  #c7d0e0
URxvt.cursorColor: #1793d1
